{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "cmake-configure-debug",
        "type": "shell",
        "command": "cmake",
        "args": [
            "--preset",
            "Debug"
        ],
        "group": "build",
        "problemMatcher": []
    },
    {
        "label": "cmake-build-debug",
        "type": "shell",
        "command": "cmake",
        "args": [
            "--build",
            "--preset",
            "Debug"
        ],
        "dependsOn": "cmake-configure-debug",
        "group": {
            "kind": "build",
            "isDefault": true
        },
        "problemMatcher": "$gcc"
    },
    {
        "label": "flash-openocd",
        "type": "shell",
        "command": "openocd",
        "options": {
            "cwd": "${workspaceFolder}"
        },
        "args": [
            "-f",
            "interface/cmsis-dap.cfg",
            // "interface/stlink.cfg",
            // "interface/jlink.cfg",
            "-f",
            "target/stm32g4x.cfg",
            "-c",
            "program build/Debug/DartADC_G474.elf reset exit"
        ],

        "dependsOn": "cmake-build-debug",
        "problemMatcher": []
    }
]
}
